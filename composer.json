{
  "name": "dschuppelius/php-translation-toolkit",
  "description": "Slim translation toolkit with provider abstraction, cache port and DeepL provider (plain curl, dependency-free).",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Daniel Joerg Schuppelius",
      "email": "info@schuppelius.org"
    }
  ],
  "autoload": {
    "psr-4": {
      "TranslationToolkit\\": "src/"
    }
  },
  "prefer-stable": true,
  "require": {
    "php": ">=8.1 <8.6",
    "ext-curl": "*",
    "ext-mbstring": "*"
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.1",
    "laravel/pint": "^1.27"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "format": "vendor/bin/pint --test",
    "format:fix": "vendor/bin/pint",
    "lint": "vendor/bin/phpstan analyse --memory-limit=1G",
    "qa": [
      "@format",
      "@lint",
      "@test"
    ]
  }
}
