{
  "name": "dschuppelius/php-translation-toolkit",
  "description": "Slim translation toolkit with provider abstraction, cache port and a DeepL provider built on php-api-toolkit.",
  "homepage": "https://github.com/DSchuppelius/php-translation-toolkit",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Daniel Joerg Schuppelius",
      "email": "info@schuppelius.org",
      "homepage": "https://schuppelius.org",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/DSchuppelius/php-translation-toolkit/issues",
    "source": "https://github.com/DSchuppelius/php-translation-toolkit"
  },
  "autoload": {
    "psr-4": {
      "TranslationToolkit\\": "src/"
    }
  },
  "prefer-stable": true,
  "config": {
    "platform": {
      "php": "8.2.0"
    }
  },
  "require": {
    "php": ">=8.1 <8.6",
    "ext-mbstring": "*",
    "daniel-jorg-schuppelius/php-api-toolkit": "^2.2"
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.1",
    "laravel/pint": "^1.27"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "format": "vendor/bin/pint --test",
    "format:fix": "vendor/bin/pint",
    "lint": "vendor/bin/phpstan analyse --memory-limit=1G",
    "qa": [
      "@format",
      "@lint",
      "@test"
    ]
  }
}
